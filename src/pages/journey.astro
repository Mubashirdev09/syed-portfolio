---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import { getCollection, render } from 'astro:content';

const allJourneyEntries = await getCollection('journey');

const sortedJourneyEntries = allJourneyEntries.sort((a, b) => {
  return a.data.date.getTime() - b.data.date.getTime();
});

const entriesWithContent = await Promise.all(
  sortedJourneyEntries.map(async (entry) => {
    const { Content } = await render(entry);
    const hasContent = Boolean(entry.body && entry.body.trim().length > 0);
    return { entry, Content, hasContent };
  })
);
---

<BaseLayout>
  <SEO
    slot="head"
    title="Path to Data Engineering"
    description="Career journey of Syed Abdul Rahman, from Computer Science and Artificial Intelligence study to hands-on data engineering projects and pipeline development."
    type="website"
  />

  <main class="page-container journey-page">
    <header class="page-header">
      <h1 class="page-title">Path to Data Engineering</h1>
      <p class="page-intro">
        My journey into data engineering is built on a foundation in Computer Science and Artificial Intelligence, strengthened through hands-on project work in data pipelines, cloud analytics, and practical problem solving.
      </p>
      <p class="page-intro-secondary">
        This timeline highlights the education, technical growth, and project work that have prepared me for data engineering roles focused on reliable, scalable, and decision-ready data systems.
      </p>
    </header>

    {entriesWithContent.length > 0 ? (
      <div class="journey-timeline">
        {entriesWithContent.map(({ entry, Content, hasContent }) => (
          <TimelineEntry
            date={entry.data.date}
            title={entry.data.title}
            type={entry.data.type}
            description={entry.data.description}
            skills={entry.data.skills}
            hasContent={hasContent}
          >
            {hasContent && <Content />}
          </TimelineEntry>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No journey entries added yet.</p>
        <p class="empty-state-sub">
          This page will highlight key education milestones, technical growth, and project experience.
        </p>
      </div>
    )}
  </main>

  <style>
    .journey-page {
      max-width: 860px;
      margin: 0 auto;
      padding: 0 1.5rem 5rem;
    }

    .page-header {
      padding: 3rem 0 2rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: clamp(2rem, 4vw, 2.8rem);
      line-height: 1.2;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--color-text);
      margin-bottom: 1rem;
    }

    .page-intro {
      max-width: 52rem;
      font-size: 1.0625rem;
      line-height: 1.8;
      color: var(--color-text);
      margin-bottom: 0.9rem;
    }

    .page-intro-secondary {
      max-width: 52rem;
      font-size: 1rem;
      line-height: 1.75;
      color: var(--color-text-secondary);
    }

    .journey-timeline {
      margin-top: 2rem;
    }

    .empty-state {
      padding: 2.5rem 0;
      color: var(--color-text-muted);
    }

    .empty-state p {
      margin: 0;
      font-size: 1rem;
      line-height: 1.7;
    }

    .empty-state-sub {
      margin-top: 0.5rem !important;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .journey-page {
        padding: 0 1rem 4rem;
      }

      .page-header {
        padding: 2.25rem 0 1.5rem;
      }

      .page-title {
        font-size: 1.85rem;
      }

      .page-intro,
      .page-intro-secondary {
        font-size: 1rem;
        line-height: 1.7;
      }
    }
  </style>
</BaseLayout>