---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured === true)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);

const caseSnapshots = featuredProjects.slice(0, 3);
---

<BaseLayout>
  <SEO 
    slot="head"
    title={`${siteConfig.author.name} - Data Engineering Candidate`}
    description="Portfolio of Syed Abdul Rahman, a data engineering candidate building ETL pipelines, cloud workflows, and analytics systems."
    type="website"
    noSuffix
  />

  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <h1 class="hero-title">{siteConfig.author.name}</h1>
          <p class="hero-role">Aspiring Data Engineer</p>
          <p class="hero-sub">
  Master’s in Computer Science and a PG Diploma in Artificial Intelligence, building hands-on ETL pipelines, cloud workflows, and analytics systems.
</p>
          <div class="hero-meta">
            Data engineering candidate focused on reliable pipelines and decision-ready data systems.
          </div>
          <div class="hero-cta">
            <a href="/projects" class="btn-primary">View Projects</a>
<a href="/contact" class="btn-secondary">Get in Touch</a>          </div>
        </div>

        <div class="hero-right">
          <div class="case-snapshots">
            {caseSnapshots.map((project) => (
              <a href={`/projects/${project.id}`} class="case-snapshot">
                <span class="case-label">Featured Project · {project.data.role}</span>
                <span class="case-title">{project.data.title}</span>
                <span class="case-outcome">{project.data.outcomeSummary}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="introduction">
      <p>
        I’m a data engineering candidate with a Master’s in Computer Science and a PG Diploma in Artificial Intelligence.
      </p>
      <p>
        I build data projects focused on ETL pipelines, structured workflows, cloud analytics, and reliable reporting. My goal is to contribute to teams building scalable, decision-ready data systems.
      </p>
      <ForwardLink href="/journey" text="Read my journey" variant="muted" />
    </section>

    <section class="thinking">
  <h2>Skills & Focus</h2>

  <div class="skills-groups">
    <div class="skill-group">
      <h3>Data Engineering</h3>
      <p>ETL pipelines · SQL · Python · PySpark · Data modeling</p>
    </div>

    <div class="skill-group">
      <h3>Cloud & Platforms</h3>
      <p>Azure Synapse Analytics · Azure Data Lake · Cloud workflows · Data warehousing</p>
    </div>

    <div class="skill-group">
      <h3>Data Science & AI</h3>
      <p>Machine learning · Artificial Intelligence · Data analysis · NLP fundamentals</p>
    </div>

    <div class="skill-group">
      <h3>Workflow & Delivery</h3>
      <p>Airflow · Kafka · GitHub Actions · Power BI · Dashboard-ready datasets</p>
    </div>
  </div>
</section>

    <section class="cta">
      <h2>Open to Data Engineering Opportunities</h2>
      <p>
        I’m currently looking for data engineering roles where I can contribute to building reliable data pipelines, cloud workflows, and analytics-ready systems.
      </p>
      <div class="cta-buttons">
        <a href="/projects" class="btn-primary">View My Work</a>
        <a href="/contact" class="btn-secondary">Get in Touch</a>
      </div>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
  padding: 3rem 0 4rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 3rem;
}

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .hero-left {
      padding-right: 2rem;
    }

  

    .hero-title {
      font-size: 3rem;
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 0.75rem;
      color: var(--color-text);
    }

    .hero-role {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      margin-bottom: 1.25rem;
    }

    .hero-sub {
      font-size: 1.0625rem;
      color: var(--color-text-secondary);
      margin-bottom: 1rem;
      line-height: 1.7;
      max-width: 38rem;
    }

    .hero-meta {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
      line-height: 1.6;
      max-width: 38rem;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      border-radius: 6px;
      transition: opacity 0.2s ease;
    }

    .btn-primary:hover {
      opacity: 0.85;
    }

    .btn-secondary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9375rem;
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: border-color 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--color-text-secondary);
    }

    .hero-right {
      padding-top: 0.5rem;
    }

    .case-snapshots {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .case-snapshot {
      display: block;
      padding: 1.25rem 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .case-snapshot:hover {
      border-color: var(--color-text-muted);
      background: var(--color-bg-elevated);
    }

    .case-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .introduction {
  max-width: 600px;
  margin-bottom: 3.5rem;
  font-size: 1.125rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

    .introduction p {
      margin-bottom: 1rem;
    }

    .introduction p:first-child {
      color: var(--color-text);
    }

    .thinking {
  margin-bottom: 3.5rem;
}

.thinking h2 {
  font-size: 1.25rem;
  font-weight: 600;
  margin-bottom: 1.25rem;
  letter-spacing: -0.01em;
}

.skills-groups {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  max-width: 800px;
}

.skill-group {
  padding: 1rem 1.1rem;
  border: 1px solid var(--color-border);
  border-radius: 8px;
  background: var(--color-bg-secondary);
}

.skill-group h3 {
  font-size: 0.9rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--color-text);
}

.skill-group p {
  font-size: 0.95rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin: 0;
}

    .cta {
      padding: 3rem 0;
      border-top: 1px solid var(--color-border);
    }

    .cta h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .cta p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      max-width: 500px;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
    }

    @media (max-width: 768px) {
      .skills-groups {
  grid-template-columns: 1fr;
}
      .home-page {
        padding: 0 1rem 3rem;
      }

      .hero {
        padding: 2.5rem 0 3rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .hero-left {
        padding-right: 0;
      }

      .hero-title {
        font-size: 2.25rem;
      }

      .hero-role {
        font-size: 1.125rem;
      }

      .hero-cta {
        flex-direction: column;
      }

      .btn-primary,
      .btn-secondary {
        text-align: center;
        width: 100%;
      }

      .case-snapshot {
        padding: 1rem 1.25rem;
      }

      .introduction {
        font-size: 1rem;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .cta-buttons .btn-primary,
      .cta-buttons .btn-secondary {
        width: 100%;
      }
    }
  </style>
</BaseLayout>