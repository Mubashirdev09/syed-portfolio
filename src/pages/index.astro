---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured === true)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);

const caseSnapshots = featuredProjects.slice(0, 3);
---

<BaseLayout>
  <SEO 
    slot="head"
    title={`${siteConfig.author.name} - Data Engineering Candidate`}
    description="Portfolio of Syed Abdul Rahman, focused on data engineering, cloud workflows, analytics systems, and hands-on projects shaped by a background in computer science and artificial intelligence."
    type="website"
    noSuffix
  />

  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-left">
          <h1 class="hero-title">{siteConfig.author.name}</h1>
          <p class="hero-role">Building reliable data systems from curiosity, discipline, and hands-on experience</p>
          <p class="hero-sub">
            I started in computer science, deepened my interest through a postgraduate diploma in Artificial Intelligence at Durham College, and continued that journey through a Master’s in Computer Science at Lakehead University — gradually becoming drawn to the engineering side of data.
          </p>
          <div class="hero-meta">
            Now focused on data engineering through cloud-based analytics, structured workflows, and projects that turn raw information into clear, usable systems.
          </div>
          <div class="hero-cta">
            <a href="/projects" class="btn-primary">View Projects</a>
            <a href="/contact" class="btn-secondary">Get in Touch</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="case-snapshots">
            {caseSnapshots.map((project) => (
              <a href={`/projects/${project.id}`} class="case-snapshot">
                <span class="case-label">Featured Project · {project.data.role}</span>
                <span class="case-title">{project.data.title}</span>
                <span class="case-outcome">{project.data.outcomeSummary}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="introduction">
      <p>
        I’m Syed Abdul Rahman, and my path into data engineering has grown through study, persistence, and a genuine fascination with how data can be transformed into something meaningful.
      </p>
      <p>
        I began with a four-year engineering background in computer science, which gave me a strong technical foundation and a habit of approaching problems with structure and patience. As I explored different career directions, I realized that artificial intelligence, machine learning, and data systems were the areas that held my attention the most.
      </p>
      <p>
        That interest became more real through hands-on work, project-based learning, and my time with Code for India Foundation, where I learned through practical experience and apprenticeship. Working on multiple projects there helped me appreciate how data is collected, cleaned, modeled, and turned into something people can actually use.
      </p>
      <p>
        After moving to Canada, I completed a postgraduate diploma in Artificial Intelligence at Durham College and later pursued a Master’s in Computer Science at Lakehead University. Across both experiences, I found myself becoming increasingly interested in data engineering — especially the design of pipelines, the discipline behind reliable workflows, and the challenge of building systems that support good decisions.
      </p>
      <p>
        A lot of my growth has come from staying consistent through deadlines, learning curves, and the balancing act of studies, independent projects, and long-term career goals. I care about doing solid work, learning deeply, and building systems that are not only technically correct, but genuinely useful.
      </p>
      <ForwardLink href="/journey" text="Read my journey" variant="muted" />
    </section>

    <section class="thinking">
      <h2>Skills & Focus</h2>
      <p class="thinking-intro">
        Focused on the tools and workflows most commonly used in modern data engineering roles, with practical experience across cloud pipelines, analytics systems, and reliable data delivery.
      </p>

      <div class="skills-groups">
        <div class="skill-group">
          <h3>Core Data Engineering</h3>
          <p>SQL, Python, ETL/ELT pipelines, PySpark, and data modeling for building structured, reliable, and scalable data workflows.</p>
        </div>

        <div class="skill-group">
          <h3>Cloud & Data Platforms</h3>
          <p>Azure Data Lake Gen2, Azure Synapse Analytics, cloud storage patterns, and warehousing concepts for analytics-ready systems.</p>
        </div>

        <div class="skill-group">
          <h3>Orchestration & Processing</h3>
          <p>Apache Airflow, Kafka, batch workflows, and distributed data processing for dependable pipeline execution.</p>
        </div>

        <div class="skill-group">
          <h3>Analytics & Delivery</h3>
          <p>GitHub Actions, Power BI, reporting layers, and dashboard-ready datasets designed for practical business use.</p>
        </div>
      </div>
    </section>

    <section class="cta">
      <span class="cta-eyebrow">Let’s Connect</span>
      <h2>Open to opportunities in data engineering</h2>
      <p>
        I’m looking for opportunities where I can continue developing my skills, contribute meaningfully to the team, and help build reliable data systems that create real value for the company.
      </p>
      <div class="cta-buttons">
        <a href="/projects" class="btn-primary">View My Work</a>
        <a href="/contact" class="btn-secondary">Get in Touch</a>
      </div>
    </section>
  </main>

  <style>
    .home-page {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    .hero {
      padding: 3rem 0 4rem;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 3rem;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    .hero-left {
      padding-right: 2rem;
    }

    .hero-title {
      font-size: 3rem;
      line-height: 1.1;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 0.75rem;
      color: var(--color-text);
    }

    .hero-role {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-text-secondary);
      margin-bottom: 1.25rem;
      line-height: 1.5;
      max-width: 38rem;
    }

    .hero-sub {
      font-size: 1.0625rem;
      color: var(--color-text-secondary);
      margin-bottom: 1rem;
      line-height: 1.75;
      max-width: 40rem;
    }

    .hero-meta {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
      line-height: 1.65;
      max-width: 38rem;
    }

    .hero-cta {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .btn-primary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      border-radius: 6px;
      transition: opacity 0.2s ease;
    }

    .btn-primary:hover {
      opacity: 0.85;
    }

    .btn-secondary {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: transparent;
      color: var(--color-text);
      font-weight: 500;
      font-size: 0.9375rem;
      text-decoration: none;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      transition: border-color 0.2s ease;
    }

    .btn-secondary:hover {
      border-color: var(--color-text-secondary);
    }

    .hero-right {
      padding-top: 0.5rem;
    }

    .case-snapshots {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .case-snapshot {
      display: block;
      padding: 1.25rem 1.5rem;
      background: var(--color-bg-secondary);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      text-decoration: none;
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .case-snapshot:hover {
      border-color: var(--color-text-muted);
      background: var(--color-bg-elevated);
    }

    .case-label {
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.375rem;
    }

    .case-title {
      display: block;
      font-size: 1rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .case-outcome {
      display: block;
      font-size: 0.875rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    .introduction {
      max-width: 720px;
      margin-bottom: 3.5rem;
      font-size: 1.05rem;
      line-height: 1.8;
      color: var(--color-text-secondary);
    }

    .introduction p {
      margin-bottom: 1rem;
    }

    .introduction p:first-child {
      color: var(--color-text);
      font-weight: 500;
    }

    .thinking {
      margin-bottom: 3.5rem;
    }

    .thinking h2 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .thinking-intro {
      max-width: 42rem;
      font-size: 0.98rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
      margin-bottom: 1.25rem;
    }

    .skills-groups {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      max-width: 800px;
    }

    .skill-group {
      padding: 1rem 1.1rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      background: var(--color-bg-secondary);
    }

    .skill-group h3 {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--color-text);
    }

    .skill-group p {
      font-size: 0.95rem;
      line-height: 1.7;
      color: var(--color-text-secondary);
      margin: 0;
    }

    .cta {
      padding: 2rem 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-bg-secondary);
      margin-top: 1rem;
    }

    .cta-eyebrow {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-muted);
      margin-bottom: 0.75rem;
    }

    .cta h2 {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      letter-spacing: -0.01em;
    }

    .cta p {
      font-size: 1rem;
      color: var(--color-text-secondary);
      margin-bottom: 1.5rem;
      max-width: 42rem;
      line-height: 1.7;
    }

    .cta-buttons {
      display: flex;
      gap: 0.875rem;
      flex-wrap: wrap;
    }

    .cta .btn-primary,
    .cta .btn-secondary {
      min-width: 170px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .skills-groups {
        grid-template-columns: 1fr;
      }

      .home-page {
        padding: 0 1rem 3rem;
      }

      .hero {
        padding: 2.5rem 0 3rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      .hero-left {
        padding-right: 0;
      }

      .hero-title {
        font-size: 2.25rem;
      }

      .hero-role {
        font-size: 1.125rem;
      }

      .hero-cta {
        flex-direction: column;
      }

      .btn-primary,
      .btn-secondary {
        text-align: center;
        width: 100%;
      }

      .case-snapshot {
        padding: 1rem 1.25rem;
      }

      .introduction {
        font-size: 1rem;
      }

      .cta-buttons {
        flex-direction: column;
      }

      .cta-buttons .btn-primary,
      .cta-buttons .btn-secondary {
        width: 100%;
      }
    }
  </style>
</BaseLayout>